{
  "framework": null,
  "buildCommand": "node --version",
  "outputDirectory": "ui",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?upstreamPath=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'self'"}
      ]
    }
  ]
}
